# --- Database (Neon Postgres) ---
# Pooled connection string used by the running app (serverless HTTP driver).
# When you provision Neon via the Vercel Marketplace this is injected automatically.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) connection string used ONLY for running migrations at build time.
# Neon provides this as DATABASE_URL_UNPOOLED. If you don't set it, migrations fall
# back to DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth ---
# The shared password trusted clients type to enter the portal.
CLIENT_PASSWORD="change-me-client"

# The private password only you (owner) use for the admin dashboard.
ADMIN_PASSWORD="change-me-admin"

# A long random string used to sign session cookies. Generate with:
#   openssl rand -base64 48
SESSION_SECRET="generate-a-long-random-string-at-least-32-chars"
